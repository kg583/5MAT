%import common.INT
%import common.NEWLINE
%import common.WS


NAME: /[-_A-Z!?]+/
PARAM: "@" NAME
INSTR: NAME

POS: "+"? INT
NEG: "-" INT
REMAIN: "$R"

READ: "$V"
READL: "$_"
READS: "$" INT
READP: "$" NAME

PEEK: "?V"
PEEKL: "?_"
PEEKS: "?" INT
PEEKP: "?" NAME

NIL: "NIL"

EXPR: /@\|.+?\|@/
RAW: /`(\\.|[^`])+`/

CHAR: /(\\x..|\\.|.)/
char: "'" (EXPR | CHAR) "'"

STRING: /\\.|[^"]/
string: "\"" (EXPR | STRING)* "\""

COMMENT: /;[^\r\n]*/

INDENT = (NEWLINE WS*)+

arg: POS | NEG | REMAIN | READ | READS | PEEK | PEEKS | NIL | PARAM | EXPR | char | string


start: lines?

lines: statement ((INDENT | "\\") statement)* INDENT*
statement: (instruction | clause | generator | group | block | RAW | COMMENT) COMMENT?
instruction: INSTR (arg ("," arg)*)? (group | block)?
clause: arg ("," arg)* (group | block)

def_gen: ".def" (def_code | def_param)
def_code: NAME (group | block)
def_param: PARAM (POS | NEG | NIL | char | string)

for_gen: ".for" PARAM arg arg arg? group
if_gen: ".if" EXPR group (".elif" EXPR group)* (".else" group)?

generator: def_gen | for_gen | if_gen

group: "[" lines? "]"
block: "{" lines? "}"


%ignore WS
